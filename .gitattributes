# Check out text as LF everywhere: tests embed fixtures and minisign
# signatures cover exact bytes, so CRLF conversion on Windows breaks them.
* text=auto eol=lf
*.minisig -text
*.pub -text
# Binary test fixtures: never convert line endings.
*.zgtrace binary
*.minisig binary
# CRLF fixture: its line endings are the point of the test.
packages/ai/testdata/frontmatter/crlf.md -text
# Generated SPIR-V (packages/vulkan/src/shaders/gen) is compared byte for byte.
*.spv binary
# read_file fixtures: encodings and line endings are what is tested.
packages/ai/testdata/tools/read/crlf.txt -text
packages/ai/testdata/tools/read/utf16le_bom.txt binary
packages/ai/testdata/tools/read/binary.bin binary
packages/ai/testdata/tools/read/image.png binary
packages/ai/eval/fixtures/notes/data.bin binary
*.pgm binary
*.ppm binary
packages/editor/testdata/encodings/** binary
packages/editor/src/model/encoding/whatwg/*.txt -text
