# Check out text as LF everywhere: tests embed fixtures and minisign
# signatures cover exact bytes, so CRLF conversion on Windows breaks them.
* text=auto eol=lf
*.minisig -text
*.pub -text
# Binary test fixtures: never convert line endings.
*.zgtrace binary
*.minisig binary
# CRLF fixture: its line endings are the point of the test.
packages/ai/testdata/frontmatter/crlf.md -text
