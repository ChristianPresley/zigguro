// Test-only font corpus (E03); not shipped in release archives. Per-file
// sources, versions and licenses: packages/text/testdata/fonts/manifest.zon.
.{
    .name = "zigguro test fonts",
    .version = "see manifest.zon",
    .license_spdx = "OFL-1.1 AND Apache-2.0",
    .source_url = "https://github.com/google/fonts",
    .shipped = false,
    .paths = .{
        "packages/text/testdata/fonts/**",
        "packages/text/fuzz/corpus/ot-face/**",
    },
    .license_text_files = .{
        "packages/text/testdata/fonts/LICENSES/FiraCode-OFL.txt",
        "packages/text/testdata/fonts/LICENSES/color-fonts-Apache-2.0.txt",
    },
}
