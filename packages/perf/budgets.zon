// The budget registry (E14.F01.S01.T01): every global and per-epic
// performance budget in one machine-readable file. Tests, benches, the HUD
// and CI read it; `zig build budgets-doc` renders docs/perf/budgets.md.
//
// Schema (packages/perf/src/budget/schema.zig), schema = 1:
//   machines: one row per MachineClass (ref_laptop_2024, ci_linux_x64,
//     ci_windows_x64). CI classes gate only relative regressions; absolute
//     limits apply to ref_laptop_2024 and to `any` (machine-independent
//     counts such as allocations or wakeups).
//   budgets: rows of
//     .id        dotted, stable, unique: ^[a-z0-9_]+(\.[a-z0-9_]+)+$
//     .owner     owning epic, E00..E17; .spec the spec ID the number comes from
//     .metric    duration_ns | bytes | count | per_second | bytes_per_second | percent
//     .stat      p50 | p95 | p99 | p999 | max | mean | total
//     .direction lower_is_better (default) | higher_is_better
//     .limit     the hard limit, in .metric units; .target the goal (optional)
//     .machine   default ref_laptop_2024
//     .source    .{ .bench = .{ .suite = <bench JSON package>, .name, .field } }
//                | .{ .scenario = .{ .name, .metric } } | .{ .runtime = "<monitor>" }
//                ("pending": nothing measures it yet; such rows use gate = .track)
//     .regression_tolerance_pct (default 10), .gate block | warn | track, .note
// Rows owned by other epics stay gate = .warn until the owner confirms.
.{
    .schema = 1,
    .machines = .{
        .{ .class = .ref_laptop_2024, .description = "Reference laptop: 8 performance cores / 16 threads, Windows 11 and a current Wayland desktop", .cpu = "x86_64-v3, 8C/16T", .ram_gb = 16, .gpu = "integrated, 2024 mid-range", .display = "2560x1600 at 120 Hz" },
        .{ .class = .ci_linux_x64, .description = "GitHub ubuntu-24.04 hosted runner (public repository)", .cpu = "4 vCPU x86_64", .ram_gb = 16, .gpu = "none (lavapipe)", .display = "headless" },
        .{ .class = .ci_windows_x64, .description = "GitHub windows-2025 hosted runner (public repository)", .cpu = "4 vCPU x86_64", .ram_gb = 16, .gpu = "none (WARP)", .display = "headless" },
        .{ .class = .any, .description = "Machine-independent (counts, allocations, wakeups)", .cpu = "any", .ram_gb = 0, .gpu = "any", .display = "any" },
    },
    .budgets = .{
        .{ .id = "startup.first_interactive_frame", .owner = "E14", .spec = "CONVENTIONS", .metric = .duration_ns, .stat = .p95, .limit = 150000000, .target = 100000000, .source = .{ .scenario = .{ .name = "startup", .metric = "first_interactive_frame" } }, .note = "process creation to first presented frame that accepts input; warm disk cache" },
        .{ .id = "input.key_to_photon", .owner = "E14", .spec = "CONVENTIONS", .metric = .duration_ns, .stat = .p99, .limit = 8000000, .target = 5000000, .source = .{ .scenario = .{ .name = "editing_100k", .metric = "key_to_photon" } }, .note = "OS key timestamp to presentation of the frame containing its effect; 100 k-line file at 120 Hz" },
        .{ .id = "ui.view_switch", .owner = "E14", .spec = "CONVENTIONS", .metric = .duration_ns, .stat = .p99, .limit = 16000000, .target = 8000000, .source = .{ .scenario = .{ .name = "view_switch", .metric = "command_to_frame" } }, .note = "command to first complete frame of the new view or panel" },
        .{ .id = "ui.frame_cpu_keystroke", .owner = "E14", .spec = "E14.F03", .metric = .duration_ns, .stat = .p99, .limit = 2000000, .target = 1000000, .source = .{ .scenario = .{ .name = "editing_100k", .metric = "frame_cpu" } }, .note = "UI-thread CPU for a keystroke frame" },
        .{ .id = "ui.thread_stall", .owner = "E14", .spec = "E14.F01.S02", .metric = .duration_ns, .stat = .max, .limit = 16000000, .target = 8000000, .source = .{ .scenario = .{ .name = "editing_100k", .metric = "max_stall" } }, .note = "longest UI-thread non-yield interval during scenarios; the watchdog warns at 50 ms" },
        .{ .id = "file.open_1gb_first_screen", .owner = "E14", .spec = "CONVENTIONS", .metric = .duration_ns, .stat = .max, .limit = 200000000, .target = 50000000, .source = .{ .scenario = .{ .name = "open_1gb", .metric = "first_screen" } }, .note = "open a 1 GB file to first screen; target is warm cache" },
        .{ .id = "workspace.fuzzy_find_1m", .owner = "E14", .spec = "CONVENTIONS", .metric = .duration_ns, .stat = .p99, .limit = 50000000, .target = 16000000, .source = .{ .scenario = .{ .name = "fuzzy_find_1m", .metric = "ranked" } }, .note = "query to ranked results over 1 M paths; target is the first 50" },
        .{ .id = "idle.cpu", .owner = "E14", .spec = "CONVENTIONS", .metric = .percent, .stat = .mean, .limit = 0.1, .target = 0, .machine = .any, .source = .{ .scenario = .{ .name = "idle", .metric = "cpu_pct" } }, .note = "process CPU while idle, 30 s window after a 5 s settle (< 30 ms CPU per 30 s)" },
        .{ .id = "idle.wakeups", .owner = "E14", .spec = "CONVENTIONS", .metric = .per_second, .stat = .mean, .limit = 0.5, .target = 0, .machine = .any, .source = .{ .scenario = .{ .name = "idle", .metric = "wakeups_per_s" } }, .note = "all-thread wakeups per second at steady state (0/s; <= 1/s during the settle window)" },
        .{ .id = "mem.idle_private", .owner = "E14", .spec = "E14.F04", .metric = .bytes, .stat = .max, .limit = 150000000, .target = 100000000, .source = .{ .scenario = .{ .name = "idle", .metric = "private_bytes" } }, .note = "private memory with one 100 k-file workspace open, idle after indexing; some GPU drivers count their allocations as private memory, so the scenario records GPU numbers alongside" },
        .{ .id = "mem.gpu_device_local", .owner = "E14", .spec = "E02", .metric = .bytes, .stat = .max, .limit = 100663296, .target = 67108864, .source = .{ .runtime = "vk_memory_budget" }, .gate = .warn, .note = "device-local GPU memory, typical session" },
        .{ .id = "mem.sample", .owner = "E14", .spec = "E14.F04.S01.T02", .metric = .duration_ns, .stat = .p99, .limit = 200000, .source = .{ .bench = .{ .suite = "zg_perf", .name = "perf.mem_sample", .field = .p99_ns } }, .gate = .warn, .note = "one memory sample (OS read, tag sums, GPU query) on the sampler worker" },
        .{ .id = "mem.tracked_alloc", .owner = "E14", .spec = "E14.F04.S01.T01", .metric = .duration_ns, .stat = .mean, .limit = 40, .source = .{ .bench = .{ .suite = "zg_perf", .name = "perf.tracked_alloc_overhead", .field = .ns_per_op } }, .gate = .warn, .note = "alloc + free through a TrackedAllocator over smp_allocator; at most 5 ns above perf.smp_alloc_free" },
        .{ .id = "perf.trace_overhead", .owner = "E14", .spec = "E14.F02.S02.T01", .metric = .percent, .stat = .mean, .limit = 1, .target = 0.5, .source = .{ .scenario = .{ .name = "editing_100k", .metric = "trace_overhead_pct" } }, .note = "keystroke-frame CPU increase with -Dtracing=zones vs off" },
        .{ .id = "perf.hud_overhead", .owner = "E14", .spec = "E14.F03.S01.T02", .metric = .duration_ns, .stat = .p99, .limit = 100000, .target = 50000, .source = .{ .bench = .{ .suite = "zg_perf_ui", .name = "perf.hud_frame", .field = .p99_ns } }, .note = "UI-thread CPU per frame with the HUD visible" },
        .{ .id = "perf.flight_recorder_overhead", .owner = "E14", .spec = "E14.F02.S02.T01", .metric = .percent, .stat = .mean, .limit = 0.5, .source = .{ .scenario = .{ .name = "editing_100k", .metric = "drain_cpu_pct" } }, .note = "drain worker CPU while typing at 10 keys/s, share of one core" },
        .{ .id = "ai.chunk_to_photon", .owner = "E10", .spec = "E14.F02.S01.T03", .metric = .duration_ns, .stat = .p99, .limit = 16700000, .target = 8330000, .source = .{ .scenario = .{ .name = "agents_10_streaming", .metric = "chunk_to_photon" } }, .gate = .warn, .note = "proposed by E14; agent stream chunk on the network worker to the frame that shows it" },
        .{ .id = "ai.tool_dispatch_overhead", .owner = "E10", .spec = "E14.F02.S01.T03", .metric = .duration_ns, .stat = .p99, .limit = 1000000, .target = 200000, .source = .{ .scenario = .{ .name = "agents_10_streaming", .metric = "tool_dispatch_overhead" } }, .gate = .warn, .note = "proposed by E14; harness time around one tool call excluding the tool" },
        .{ .id = "ai.ttft", .owner = "E10", .spec = "E14.F02.S01.T03", .metric = .duration_ns, .stat = .p50, .limit = 2000000000, .source = .{ .scenario = .{ .name = "agents_10_streaming", .metric = "ttft" } }, .gate = .track, .note = "time to first token; server-bound, reported and never gated" },
        .{ .id = "perf.init", .owner = "E14", .spec = "E14", .metric = .duration_ns, .stat = .p99, .limit = 300000, .source = .{ .bench = .{ .suite = "zg_perf", .name = "perf.init", .field = .p99_ns } }, .gate = .warn, .note = "zg_perf init on the startup path" },
        .{ .id = "perf.perfetto_export_1m", .owner = "E14", .spec = "E14.F02.S01.T01", .metric = .duration_ns, .stat = .mean, .limit = 1200000000, .source = .{ .bench = .{ .suite = "zg_perf", .name = "perf.perfetto_export_1m", .field = .ns_per_op } }, .gate = .warn, .note = "export of 1 M events on a worker (>= 50 M events/min)" },
        .{ .id = "perf.flight_dump_10s", .owner = "E14", .spec = "E14.F02.S02.T01", .metric = .duration_ns, .stat = .max, .limit = 200000000, .source = .{ .bench = .{ .suite = "zg_perf", .name = "perf.flight_dump_10s", .field = .ns_per_op } }, .gate = .warn, .note = "flight-recorder dump of a 10 s window, off-thread" },
        .{ .id = "startup.mark", .owner = "E14", .spec = "E14.F05.S01.T01", .metric = .duration_ns, .stat = .mean, .limit = 50, .source = .{ .bench = .{ .suite = "zg_perf", .name = "perf.startup_mark", .field = .ns_per_op } }, .gate = .warn, .note = "a first startup phase mark (clock read, CAS, trace instant)" },
        .{ .id = "startup.phase.e00", .owner = "E00", .spec = "E14.F05.S01", .metric = .duration_ns, .stat = .p95, .limit = 2000000, .source = .{ .scenario = .{ .name = "startup", .metric = "phase.e00" } }, .gate = .warn, .note = "E00 runtime init" },
        .{ .id = "startup.phase.e01", .owner = "E01", .spec = "E14.F05.S01", .metric = .duration_ns, .stat = .p95, .limit = 15000000, .source = .{ .scenario = .{ .name = "startup", .metric = "phase.e01" } }, .gate = .warn, .note = "platform + first window (10 ms Wayland, 15 ms Win32)" },
        .{ .id = "startup.phase.e02", .owner = "E02", .spec = "E14.F05.S01", .metric = .duration_ns, .stat = .p95, .limit = 40000000, .source = .{ .scenario = .{ .name = "startup", .metric = "phase.e02" } }, .gate = .warn, .note = "GPU bring-up, warm cache, overlapped with window creation" },
        .{ .id = "startup.phase.e03", .owner = "E03", .spec = "E14.F05.S01", .metric = .duration_ns, .stat = .p95, .limit = 12000000, .source = .{ .scenario = .{ .name = "startup", .metric = "phase.e03" } }, .gate = .warn, .note = "fonts" },
        .{ .id = "startup.phase.e04", .owner = "E04", .spec = "E14.F05.S01", .metric = .duration_ns, .stat = .p95, .limit = 10000000, .source = .{ .scenario = .{ .name = "startup", .metric = "phase.e04" } }, .gate = .warn, .note = "first workbench build/layout/paint" },
        .{ .id = "startup.phase.e08", .owner = "E08", .spec = "E14.F05.S01", .metric = .duration_ns, .stat = .p95, .limit = 10000000, .source = .{ .scenario = .{ .name = "startup", .metric = "phase.e08" } }, .gate = .warn, .note = "session restore" },
        .{ .id = "startup.phase.e15", .owner = "E15", .spec = "E14.F05.S01", .metric = .duration_ns, .stat = .p95, .limit = 5000000, .source = .{ .scenario = .{ .name = "startup", .metric = "phase.e15" } }, .gate = .warn, .note = "settings/keymap load (target; E15 to confirm)" },
        .{ .id = "core.runtime_init", .owner = "E00", .spec = "E00.F04.S02", .metric = .duration_ns, .stat = .p99, .limit = 2000000, .source = .{ .runtime = "pending" }, .gate = .track, .note = "allocator + Io.Threaded + logger + mailbox" },
        .{ .id = "core.mailbox_push_pop", .owner = "E00", .spec = "E00.F04.S02", .metric = .duration_ns, .stat = .p99, .limit = 1000, .source = .{ .bench = .{ .suite = "zg_core", .name = "mailbox post+drain (1 producer)", .field = .p99_ns } }, .gate = .warn, .note = "no allocation" },
        .{ .id = "core.mailbox_allocs", .owner = "E00", .spec = "E00.F04.S02", .metric = .count, .stat = .mean, .limit = 0.001, .machine = .any, .source = .{ .bench = .{ .suite = "zg_core", .name = "mailbox post+drain (1 producer)", .field = .allocs_per_op } }, .gate = .warn, .note = "mailbox push/pop never allocates" },
        .{ .id = "core.trace_zone", .owner = "E00", .spec = "E00.F04.S03.T02", .metric = .duration_ns, .stat = .p99, .limit = 40, .source = .{ .runtime = "pending" }, .gate = .track, .note = "enabled trace zone; 0 ns when compiled out" },
        .{ .id = "core.log_filtered", .owner = "E00", .spec = "E00.F04.S01", .metric = .duration_ns, .stat = .p99, .limit = 2, .source = .{ .bench = .{ .suite = "zg_core", .name = "log filtered out", .field = .p99_ns } }, .gate = .warn, .note = "a filtered-out log call costs no work" },
        .{ .id = "jsonrpc.frame_64k", .owner = "E00", .spec = "E00.F05", .metric = .duration_ns, .stat = .p99, .limit = 20000, .source = .{ .bench = .{ .suite = "zg_jsonrpc", .name = "framing: content-length 64 KiB frame read", .field = .p99_ns } }, .gate = .warn, .note = "framing overhead beyond std.json" },
        .{ .id = "jsonrpc.dispatch_overhead", .owner = "E00", .spec = "E00.F05", .metric = .duration_ns, .stat = .p99, .limit = 5000, .source = .{ .bench = .{ .suite = "zg_jsonrpc", .name = "endpoint: request/response round trip (PipePair)", .field = .p99_ns } }, .gate = .warn, .note = "round-trip dispatch overhead on top of the transport" },
        .{ .id = "net.sse_parse", .owner = "E00", .spec = "E00.F06.S02", .metric = .bytes_per_second, .stat = .mean, .direction = .higher_is_better, .limit = 500000000, .source = .{ .bench = .{ .suite = "zg_net", .name = "sse: parse 8 MiB of data lines", .field = .throughput_bps } }, .gate = .warn },
        .{ .id = "ci.pr_gate_wall", .owner = "E00", .spec = "E00.F02", .metric = .duration_ns, .stat = .max, .limit = 900000000000, .machine = .ci_linux_x64, .source = .{ .runtime = "pending" }, .gate = .track, .note = "PR gate wall clock" },
        .{ .id = "ci.test_e00", .owner = "E00", .spec = "E00.F02", .metric = .duration_ns, .stat = .max, .limit = 30000000000, .machine = .ci_linux_x64, .source = .{ .runtime = "pending" }, .gate = .track, .note = "zig build test for the E00 packages" },
        .{ .id = "platform.first_window_wayland", .owner = "E01", .spec = "E01.F04", .metric = .duration_ns, .stat = .p95, .limit = 10000000, .source = .{ .runtime = "pending" }, .gate = .track, .note = "Platform.init + first window mapped and configure acked" },
        .{ .id = "platform.first_window_win32", .owner = "E01", .spec = "E01.F02", .metric = .duration_ns, .stat = .p95, .limit = 15000000, .source = .{ .runtime = "pending" }, .gate = .track, .note = "CreateWindowExW to first WM_SIZE (and X11)" },
        .{ .id = "platform.input_to_ring", .owner = "E01", .spec = "E01.F01", .metric = .duration_ns, .stat = .p99, .limit = 50000, .source = .{ .runtime = "pending" }, .gate = .track, .note = "OS input event to EventRing push; 0 allocations" },
        .{ .id = "platform.ring_to_ui_wake", .owner = "E01", .spec = "E01.F01", .metric = .duration_ns, .stat = .p99, .limit = 100000, .source = .{ .runtime = "pending" }, .gate = .track },
        .{ .id = "platform.xkb_keymap_parse", .owner = "E01", .spec = "E01.F04", .metric = .duration_ns, .stat = .max, .limit = 2000000, .source = .{ .runtime = "pending" }, .gate = .track, .note = "typical 60-120 KB keymap, off the UI thread" },
        .{ .id = "platform.wayland_decode", .owner = "E01", .spec = "E01.F04", .metric = .per_second, .stat = .mean, .direction = .higher_is_better, .limit = 2000000, .source = .{ .runtime = "pending" }, .gate = .track, .note = "messages per second per core, 0 allocations" },
        .{ .id = "platform.idle_wakeups", .owner = "E01", .spec = "E01", .metric = .per_second, .stat = .mean, .limit = 0.5, .machine = .any, .source = .{ .runtime = "pending" }, .gate = .track, .note = "0 per second with no input and no animation" },
        .{ .id = "platform.shm_copy_4k", .owner = "E01", .spec = "E01.F04", .metric = .duration_ns, .stat = .p99, .limit = 4000000, .source = .{ .runtime = "pending" }, .gate = .track },
        .{ .id = "platform.pty_spawn_linux", .owner = "E01", .spec = "E01.F06", .metric = .duration_ns, .stat = .p95, .limit = 5000000, .source = .{ .runtime = "pending" }, .gate = .track },
        .{ .id = "platform.conpty_spawn", .owner = "E01", .spec = "E01.F06", .metric = .duration_ns, .stat = .p95, .limit = 40000000, .source = .{ .runtime = "pending" }, .gate = .track },
        .{ .id = "platform.compose_lookup", .owner = "E01", .spec = "E01.F03", .metric = .duration_ns, .stat = .p99, .limit = 1000, .source = .{ .runtime = "pending" }, .gate = .track },
        .{ .id = "vulkan.gpu_frame", .owner = "E02", .spec = "E02.F06.S04", .metric = .duration_ns, .stat = .p95, .limit = 1000000, .source = .{ .runtime = "gpu.frame" }, .gate = .warn, .note = "typical editor frame at 2560x1600 on a 2024 iGPU" },
        .{ .id = "vulkan.gpu_keystroke_frame", .owner = "E02", .spec = "E02.F04", .metric = .duration_ns, .stat = .p95, .limit = 250000, .source = .{ .runtime = "pending" }, .gate = .track },
        .{ .id = "vulkan.encode", .owner = "E02", .spec = "E02.F03", .metric = .duration_ns, .stat = .p99, .limit = 500000, .source = .{ .runtime = "render.encode" }, .gate = .warn, .note = "DrawList to command buffer submit" },
        .{ .id = "vulkan.draw_calls", .owner = "E02", .spec = "E02.F03", .metric = .count, .stat = .max, .limit = 8, .machine = .any, .source = .{ .runtime = "pending" }, .gate = .track, .note = "draw calls per typical frame" },
        .{ .id = "vulkan.recreate", .owner = "E02", .spec = "E02.F04", .metric = .duration_ns, .stat = .max, .limit = 5000000, .source = .{ .runtime = "pending" }, .gate = .track, .note = "swapchain recreate on resize" },
        .{ .id = "vulkan.init_warm", .owner = "E02", .spec = "E02.F01", .metric = .duration_ns, .stat = .p95, .limit = 40000000, .source = .{ .runtime = "pending" }, .gate = .track, .note = "loader + instance + device + pipelines, warm cache" },
        .{ .id = "vulkan.pipeline_cache_load", .owner = "E02", .spec = "E02.F05", .metric = .duration_ns, .stat = .max, .limit = 3000000, .source = .{ .runtime = "pending" }, .gate = .track },
        .{ .id = "vulkan.software_1080p", .owner = "E02", .spec = "E02.F07", .metric = .duration_ns, .stat = .p95, .limit = 8000000, .source = .{ .runtime = "pending" }, .gate = .track, .note = "software renderer, full redraw, 8 threads" },
        .{ .id = "text.glyph_cache_hit", .owner = "E03", .spec = "E03.F07", .metric = .duration_ns, .stat = .p99, .limit = 50, .target = 10, .source = .{ .bench = .{ .suite = "zg_text", .name = "text.cache_hit", .field = .p99_ns } }, .gate = .warn },
        .{ .id = "text.layout_200col", .owner = "E03", .spec = "E03.F06", .metric = .duration_ns, .stat = .p99, .limit = 20000, .target = 3000, .source = .{ .bench = .{ .suite = "zg_text", .name = "text.layout_200col", .field = .p99_ns } }, .gate = .warn },
        .{ .id = "text.shape_latin_1k", .owner = "E03", .spec = "E03.F04", .metric = .duration_ns, .stat = .p99, .limit = 60000, .source = .{ .bench = .{ .suite = "zg_text", .name = "text.shape_latin_1k", .field = .p99_ns } }, .gate = .warn, .note = "#352: 99 us on the cloud VM (HarfBuzz 74 us there)" },
        .{ .id = "text.shape_arabic_1k", .owner = "E03", .spec = "E03.F04", .metric = .duration_ns, .stat = .p99, .limit = 250000, .source = .{ .bench = .{ .suite = "zg_text", .name = "text.shape_arabic_1k", .field = .p99_ns } }, .gate = .warn },
