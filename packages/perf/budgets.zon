        .{ .id = "text.raster_14px", .owner = "E03", .spec = "E03.F02", .metric = .duration_ns, .stat = .mean, .limit = 4000, .source = .{ .bench = .{ .suite = "zg_text", .name = "text.raster_14px", .field = .ns_per_op } }, .gate = .warn },
        .{ .id = "text.raster_64px_cjk", .owner = "E03", .spec = "E03.F02", .metric = .duration_ns, .stat = .mean, .limit = 25000, .source = .{ .bench = .{ .suite = "zg_text", .name = "text.raster_64px_cjk", .field = .ns_per_op } }, .gate = .warn },
        .{ .id = "text.colr_32px", .owner = "E03", .spec = "E03.F03", .metric = .duration_ns, .stat = .mean, .limit = 300000, .source = .{ .bench = .{ .suite = "zg_text", .name = "text.colr_32px", .field = .ns_per_op } }, .gate = .warn },
