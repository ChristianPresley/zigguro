// VS Code workbench colour ids → zigguro tokens (dotted names). For a
// token named by several ids, the first id the theme sets wins.
.{
    .{ .id = "editor.background", .token = "bg.base" },
    .{ .id = "editorWidget.background", .token = "bg.elevated" },
    .{ .id = "menu.background", .token = "bg.elevated" },
    .{ .id = "dropdown.background", .token = "bg.elevated" },
    .{ .id = "sideBar.background", .token = "bg.sunken" },
    .{ .id = "panel.background", .token = "bg.sunken" },
    .{ .id = "activityBar.background", .token = "bg.sunken" },
    .{ .id = "quickInput.background", .token = "bg.overlay" },
    .{ .id = "notifications.background", .token = "bg.overlay" },
    .{ .id = "editorHoverWidget.background", .token = "bg.overlay" },
    .{ .id = "editor.foreground", .token = "fg" },
    .{ .id = "foreground", .token = "fg" },
    .{ .id = "descriptionForeground", .token = "fg.muted" },
    .{ .id = "editorLineNumber.foreground", .token = "fg.muted" },
    .{ .id = "disabledForeground", .token = "fg.disabled" },
    .{ .id = "button.foreground", .token = "fg.on.accent" },
    .{ .id = "textLink.foreground", .token = "fg.link" },
    .{ .id = "panel.border", .token = "border" },
    .{ .id = "editorGroup.border", .token = "border" },
    .{ .id = "widget.border", .token = "border" },
    .{ .id = "contrastBorder", .token = "border.strong" },
    .{ .id = "focusBorder", .token = "focus.ring" },
    .{ .id = "button.background", .token = "accent" },
    .{ .id = "button.hoverBackground", .token = "accent.hover" },
    .{ .id = "errorForeground", .token = "danger" },
    .{ .id = "editorError.foreground", .token = "danger" },
    .{ .id = "editorWarning.foreground", .token = "warning" },
    .{ .id = "list.warningForeground", .token = "warning" },
    .{ .id = "gitDecoration.addedResourceForeground", .token = "success" },
    .{ .id = "testing.iconPassed", .token = "success" },
    .{ .id = "editorInfo.foreground", .token = "info" },
    .{ .id = "button.secondaryBackground", .token = "button.bg" },
    .{ .id = "button.secondaryHoverBackground", .token = "button.bg.hover" },
    .{ .id = "button.secondaryForeground", .token = "button.fg" },
    .{ .id = "button.border", .token = "button.border" },
    .{ .id = "input.background", .token = "control.bg" },
    .{ .id = "checkbox.background", .token = "control.bg" },
    .{ .id = "input.border", .token = "control.border" },
    .{ .id = "checkbox.border", .token = "control.border" },
    .{ .id = "inputOption.activeBackground", .token = "control.checked" },
    .{ .id = "progressBar.background", .token = "control.checked" },
    .{ .id = "scrollbarSlider.background", .token = "scrollbar.thumb" },
    .{ .id = "scrollbarSlider.activeBackground", .token = "control.thumb" },
    .{ .id = "editor.selectionBackground", .token = "selection.bg" },
    .{ .id = "list.activeSelectionBackground", .token = "selection.bg" },
    .{ .id = "list.hoverBackground", .token = "hover.bg" },
    .{ .id = "toolbar.hoverBackground", .token = "hover.bg" },
    .{ .id = "badge.background", .token = "badge.bg" },
    .{ .id = "badge.foreground", .token = "badge.fg" },
    .{ .id = "widget.shadow", .token = "shadow" },
    .{ .id = "list.highlightForeground", .token = "quick.input.highlight" },
}
