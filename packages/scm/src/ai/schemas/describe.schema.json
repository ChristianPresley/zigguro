{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Change description",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string",
      "description": "One line, imperative mood, no trailing period."
    },
    "body": {
      "type": "string",
      "description": "Why the change was made and what a reviewer should know; may be empty."
    },
    "trailers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "value": { "type": "string" }
        },
        "required": ["key", "value"],
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": ["subject", "body", "trailers", "confidence"],
  "additionalProperties": false
}
