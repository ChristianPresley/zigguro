# Hover (markdown with a disallowed link, then null), document highlight
# (read and write), definition (a link and a location in another file,
# duplicated) and references.
> initialize
< {"id": $1, "result": {"capabilities": {"positionEncoding": "utf-8", "textDocumentSync": 2, "hoverProvider": true, "documentHighlightProvider": true, "definitionProvider": true, "referencesProvider": true}}}
> initialized
> textDocument/didOpen
> textDocument/hover {"position": {"line": 1, "character": 6}}
< {"id": $1, "result": {"contents": {"kind": "markdown", "value": "```zig\nconst b: u32\n```\nSee [docs](command:rm.rf) and [site](https://ziglang.org)."}, "range": {"start": {"line": 1, "character": 6}, "end": {"line": 1, "character": 7}}}}
> textDocument/hover {"position": {"line": 0, "character": 0}}
< {"id": $1, "result": null}
> textDocument/documentHighlight {"position": {"line": 0, "character": 6}}
< {"id": $1, "result": [{"range": {"start": {"line": 0, "character": 6}, "end": {"line": 0, "character": 7}}, "kind": 3}, {"range": {"start": {"line": 1, "character": 15}, "end": {"line": 1, "character": 16}}, "kind": 2}]}
> textDocument/definition {"position": {"line": 1, "character": 15}}
< {"id": $1, "result": [{"targetUri": "file:///${workspace}/other.zig", "targetRange": {"start": {"line": 3, "character": 0}, "end": {"line": 5, "character": 1}}, "targetSelectionRange": {"start": {"line": 3, "character": 4}, "end": {"line": 3, "character": 5}}}, {"targetUri": "file:///${workspace}/main.zig", "targetRange": {"start": {"line": 0, "character": 0}, "end": {"line": 0, "character": 12}}, "targetSelectionRange": {"start": {"line": 0, "character": 6}, "end": {"line": 0, "character": 7}}}, {"targetUri": "file:///${workspace}/main.zig", "targetRange": {"start": {"line": 0, "character": 0}, "end": {"line": 0, "character": 12}}, "targetSelectionRange": {"start": {"line": 0, "character": 6}, "end": {"line": 0, "character": 7}}}]}
> textDocument/references {"position": {"line": 0, "character": 6}, "context": {"includeDeclaration": true}}
< {"id": $1, "result": [{"uri": "file:///${workspace}/main.zig", "range": {"start": {"line": 1, "character": 15}, "end": {"line": 1, "character": 16}}}, {"uri": "file:///${workspace}/main.zig", "range": {"start": {"line": 0, "character": 6}, "end": {"line": 0, "character": 7}}}]}
