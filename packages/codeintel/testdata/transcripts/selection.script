# Selection ranges for two cursors.
> initialize
< {"id": $1, "result": {"capabilities": {"textDocumentSync": 1, "selectionRangeProvider": true}}}
> initialized
> textDocument/didOpen
> textDocument/selectionRange {"positions": [{"line": 0, "character": 6}, {"line": 1, "character": 2}]}
< {"id": $1, "result": [{"range": {"start": {"line": 0, "character": 6}, "end": {"line": 0, "character": 7}}, "parent": {"range": {"start": {"line": 0, "character": 0}, "end": {"line": 0, "character": 12}}, "parent": {"range": {"start": {"line": 0, "character": 0}, "end": {"line": 2, "character": 0}}}}}, {"range": {"start": {"line": 1, "character": 2}, "end": {"line": 1, "character": 3}}, "parent": {"range": {"start": {"line": 1, "character": 0}, "end": {"line": 1, "character": 5}}, "parent": {"range": {"start": {"line": 0, "character": 0}, "end": {"line": 2, "character": 0}}}}}]}
