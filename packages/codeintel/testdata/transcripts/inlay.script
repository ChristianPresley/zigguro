# Inlay hints: the visible lines plus a screen around them, nothing more
# while scrolling inside them, the next screens when scrolling far; a
# resolve on hover; a refresh asks the visible lines again.
> initialize
< {"id": $1, "result": {"capabilities": {"positionEncoding": "utf-8", "textDocumentSync": 2, "inlayHintProvider": {"resolveProvider": true}}}}
> initialized
> textDocument/didOpen
> textDocument/inlayHint {"range": {"start": {"line": 0, "character": 0}, "end": {"line": 20, "character": 0}}}
< {"id": $1, "result": [{"position": {"line": 1, "character": 5}, "label": ": i32", "kind": 1, "paddingLeft": true}, {"position": {"line": 2, "character": 10}, "label": [{"value": "x"}, {"value": ":", "location": {"uri": "file://${workspace}/main.zig", "range": {"start": {"line": 0, "character": 3}, "end": {"line": 0, "character": 4}}}}], "kind": 2, "data": {"k": 1}}]}
> textDocument/inlayHint {"range": {"start": {"line": 20, "character": 0}}}
< {"id": $1, "result": []}
> inlayHint/resolve {"data": {"k": 1}}
< {"id": $1, "result": {"position": {"line": 2, "character": 10}, "label": [{"value": "x"}, {"value": ":", "location": {"uri": "file://${workspace}/main.zig", "range": {"start": {"line": 0, "character": 3}, "end": {"line": 0, "character": 4}}}}], "kind": 2, "tooltip": "parameter x"}}
< {"id": 902, "method": "workspace/inlayHint/refresh"}
> response {"id": 902, "result": null}
> textDocument/inlayHint {"range": {"start": {"line": 20, "character": 0}}}
< {"id": $1, "result": [{"position": {"line": 35, "character": 2}, "label": "y:", "kind": 2, "paddingRight": true}]}
> shutdown
< {"id": $1, "result": null}
> exit
