# Launch, stop at a breakpoint, inspect the stack, continue to the end.
> initialize {"adapterID": "fake", "linesStartAt1": true}
< {"body": {"supportsConfigurationDoneRequest": true, "supportsCancelRequest": true}}
> launch {"program": "${workspace}/zig-out/bin/app"}
< {}
< event initialized
> setBreakpoints {"source": {"path": "${workspace}/src/main.zig"}, "breakpoints": [{"line": 5}]}
< {"body": {"breakpoints": [{"id": 1, "verified": true, "line": 5}]}}
> configurationDone
< {}
< event process {"name": "app", "systemProcessId": 4242, "startMethod": "launch"}
< event stopped {"reason": "breakpoint", "threadId": 1, "hitBreakpointIds": [1], "allThreadsStopped": true}
> threads
< {"body": {"threads": [{"id": 1, "name": "main"}]}}
> stackTrace {"threadId": 1}
< {"body": {"stackFrames": [{"id": 1000, "name": "main", "line": 5, "column": 1, "source": {"path": "${workspace}/src/main.zig"}}], "totalFrames": 1}}
> continue {"threadId": 1}
< {"body": {"allThreadsContinued": true}}
< event continued {"threadId": 1, "allThreadsContinued": true}
< event exited {"exitCode": 0}
< event terminated
> disconnect
< {}
