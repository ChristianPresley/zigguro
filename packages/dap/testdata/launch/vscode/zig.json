{
    // Zig project, as the Zig and CodeLLDB extensions write it.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug app",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/zig-out/bin/app",
            "args": ["--verbose"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "zig build",
            "windows": { "program": "${workspaceFolder}/zig-out/bin/app.exe" },
        },
        {
            "name": "Debug tests",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/zig-out/bin/test",
            "stopOnEntry": false,
        },
    ],
}
