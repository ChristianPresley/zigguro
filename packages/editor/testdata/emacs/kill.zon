// Emacs kill cases; `.after` is written by oracle.py from GNU Emacs.
.{
    .{ .name = "C-k rest of line +kill", .before = "ab¦cd\nef", .keys = "<C-k>", .after = "ab¦\nef\n[kill] \"cd\"" },
    .{ .name = "C-k at eol kills newline +kill", .before = "abcd¦\nef", .keys = "<C-k>", .after = "abcd¦ef\n[kill] \"\\n\"" },
    .{ .name = "C-k twice appends +kill", .before = "ab¦cd\nef", .keys = "<C-k><C-k>", .after = "ab¦ef\n[kill] \"cd\\n\"" },
    .{ .name = "C-k blank rest kills newline +kill", .before = "ab¦   \nef", .keys = "<C-k>", .after = "ab¦ef\n[kill] \"   \\n\"" },
    .{ .name = "C-k at end fails +kill", .before = "ab¦", .keys = "<C-k><C-k>x", .after = "ab¦\n[kill] -" },
    .{ .name = "C-k with arg +kill", .before = "¦l1\nl2\nl3\nl4", .keys = "<C-u>2<C-k>", .after = "¦l3\nl4\n[kill] \"l1\\nl2\\n\"" },
    .{ .name = "C-k arg 0 +kill", .before = "ab¦cd", .keys = "<M-0><C-k>", .after = "¦cd\n[kill] \"ab\"" },
    .{ .name = "M-d +kill", .before = "¦foo bar", .keys = "<M-d>", .after = "¦ bar\n[kill] \"foo\"" },
    .{ .name = "M-d M-d appends +kill", .before = "¦foo bar baz", .keys = "<M-d><M-d>", .after = "¦ baz\n[kill] \"foo bar\"" },
    .{ .name = "M-BS +kill", .before = "foo bar¦", .keys = "<M-BS>", .after = "foo ¦\n[kill] \"bar\"" },
    .{ .name = "M-BS twice prepends +kill", .before = "foo bar baz¦", .keys = "<M-BS><M-BS>", .after = "foo ¦\n[kill] \"bar baz\"" },
    .{ .name = "kill then move breaks append +ring", .before = "¦foo bar", .keys = "<M-d><C-f><M-d>", .after = " ¦\n[ring] [\"bar\", \"foo\"]" },
    .{ .name = "C-w region +kill", .before = "¦foo bar", .keys = "<C-Space><M-f><C-w>", .after = "¦ bar\n[kill] \"foo\"" },
    .{ .name = "C-w backward region +kill", .before = "foo bar¦", .keys = "<C-Space><M-b><C-w>", .after = "foo ¦\n[kill] \"bar\"" },
    .{ .name = "C-w after C-k appends +kill", .before = "¦ab\ncd", .keys = "<C-k><C-Space><C-e><C-w>", .after = "¦\ncd\n[kill] \"\"" },
    .{ .name = "M-w copies +kill", .before = "¦foo bar", .keys = "<C-Space><M-f><M-w>", .after = "foo¦ bar\n[kill] \"foo\"" },
    .{ .name = "C-y yanks", .before = "¦foo bar", .keys = "<M-d><C-e><C-y>", .after = " barfoo¦" },
    .{ .name = "C-y twice", .before = "¦ab", .keys = "<C-k><C-y><C-y>", .after = "abab¦" },
    .{ .name = "C-y M-y +ring", .before = "¦a b c", .keys = "<M-d><M-f><C-Space><M-d><C-f><M-d><C-e><C-y><M-y>", .after = " b¦\n[ring] [\" c\", \"a\"]" },
    .{ .name = "M-y rotates twice", .before = "¦one two three", .keys = "<M-d><C-f><M-d><C-f><M-d><C-y><M-y><M-y>", .after = "  one¦" },
    .{ .name = "C-y after M-y yanks rotated", .before = "¦one two", .keys = "<M-d><C-f><M-d><C-y><M-y><C-e><C-y>", .after = " oneone¦" },
    .{ .name = "C-u C-y point before", .before = "¦foo bar", .keys = "<M-d><C-e><C-u><C-y>", .after = " bar¦foo" },
    .{ .name = "C-y 2", .before = "¦one two", .keys = "<M-d><C-f><M-d><M-2><C-y>", .after = " one¦" },
    .{ .name = "C-y sets mark +mark", .before = "¦foo bar", .keys = "<M-d><C-e><C-y>", .after = " barfoo¦\n[mark 4]" },
    .{ .name = "C-d deletes not kills +kill", .before = "¦abc", .keys = "<C-d>", .after = "¦bc\n[kill] -" },
    .{ .name = "C-d with arg kills +kill", .before = "¦abcd", .keys = "<M-2><C-d>", .after = "¦cd\n[kill] \"ab\"" },
    .{ .name = "C-d at end fails", .before = "ab¦", .keys = "<C-d>x", .after = "ab¦" },
    .{ .name = "BS", .before = "ab¦c", .keys = "<BS>", .after = "a¦c" },
    .{ .name = "BS active region", .before = "a«bc¦d", .keys = "<BS>", .after = "a¦d" },
    .{ .name = "C-y empty ring fails", .before = "¦ab", .keys = "<C-y>x", .after = "¦ab" },
}
