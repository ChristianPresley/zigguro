// Emacs motion cases; `.after` is written by oracle.py from GNU Emacs.
.{
    .{ .name = "C-f", .before = "¦abc", .keys = "<C-f>", .after = "a¦bc" },
    .{ .name = "C-f across line", .before = "a¦\nb", .keys = "<C-f>", .after = "a\n¦b" },
    .{ .name = "C-f at end fails", .before = "ab¦", .keys = "<C-f>x", .after = "ab¦" },
    .{ .name = "C-b", .before = "ab¦c", .keys = "<C-b><C-b>", .after = "¦abc" },
    .{ .name = "C-b at start fails", .before = "¦ab", .keys = "<C-b>x", .after = "¦ab" },
    .{ .name = "C-n keeps column", .before = "ab¦cd\nx\nefgh", .keys = "<C-n><C-n>", .after = "abcd\nx\nef¦gh" },
    .{ .name = "C-n on last line", .before = "a\nb¦b", .keys = "<C-n>x", .after = "a\nbb¦" },
    .{ .name = "C-p", .before = "abcd\nef¦gh", .keys = "<C-p>", .after = "ab¦cd\nefgh" },
    .{ .name = "C-p on first line", .before = "ab¦c\nd", .keys = "<C-p>x", .after = "¦abc\nd" },
    .{ .name = "C-a C-e", .before = "ab¦cd\nef", .keys = "<C-e>X<C-a>Y", .after = "Y¦abcdX\nef" },
    .{ .name = "C-e with arg", .before = "¦ab\ncd\nef", .keys = "<C-u>2<C-e>", .after = "ab\ncd¦\nef" },
    .{ .name = "M-f", .before = "¦foo bar baz", .keys = "<M-f><M-f>", .after = "foo bar¦ baz" },
    .{ .name = "M-f punctuation", .before = "¦foo, bar.baz", .keys = "<M-f><M-f><M-f>", .after = "foo, bar.baz¦" },
    .{ .name = "M-f at end", .before = "foo¦", .keys = "<M-f>x", .after = "foox¦" },
    .{ .name = "M-b", .before = "foo bar ba¦z", .keys = "<M-b><M-b>", .after = "foo ¦bar baz" },
    .{ .name = "M-b across lines", .before = "foo\n  ¦bar", .keys = "<M-b>", .after = "¦foo\n  bar" },
    .{ .name = "M-lt M-gt", .before = "ab\ncd¦\nef", .keys = "<M-lt>X<M-gt>Y", .after = "Xab\ncd\nefY¦" },
    .{ .name = "M-lt sets mark +mark", .before = "ab¦cd", .keys = "<M-lt>", .after = "¦abcd\n[mark 2]" },
    .{ .name = "down arrow", .before = "a¦b\ncd", .keys = "<Down>", .after = "ab\nc¦d" },
    .{ .name = "C-n goal past short line", .before = "abcd¦\nx\nabcdef", .keys = "<C-n><C-n>", .after = "abcd\nx\nabcd¦ef" },
    .{ .name = "M-f unicode", .before = "¦héllo wörld", .keys = "<M-f>", .after = "héllo¦ wörld" },
}
