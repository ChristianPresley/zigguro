// zigguro's own key bindings (the preset's lowest layer: presets and the
// user's keybindings.json win). VS Code's explorer, problems and source
// control keys, note search, multiple terminals, the build task and the
// debugger.
.{
    // workbench.view.explorer
    .{ .key = "mod+shift+e", .command = "workbench.showExplorer" },
    // workbench.view.scm
    .{ .key = "mod+shift+g", .command = "workbench.showScm" },
    // workbench.view.debug
    .{ .key = "mod+shift+d", .command = "workbench.showDebug" },
    // The debugger (VS Code's workbench.action.debug.start / continue /
    // run / stop / restart / pause / stepOver / stepInto / stepOut and
    // editor.debug.action.toggleBreakpoint). Later entries win.
    .{ .key = "f5", .command = "debug.start", .when = "!inDebugMode" },
    .{ .key = "f5", .command = "debug.continue", .when = "inDebugMode && debugState == 'stopped'" },
    .{ .key = "mod+f5", .command = "debug.runWithoutDebugging", .when = "!inDebugMode" },
    .{ .key = "shift+f5", .command = "debug.stop", .when = "inDebugMode" },
    .{ .key = "mod+shift+f5", .command = "debug.restart", .when = "inDebugMode" },
    .{ .key = "f6", .command = "debug.pause", .when = "inDebugMode && debugState == 'running'" },
    .{ .key = "f9", .command = "debug.toggleBreakpoint", .when = "editorTextFocus" },
    .{ .key = "f10", .command = "debug.stepOver", .when = "inDebugMode && debugState == 'stopped'" },
    .{ .key = "f11", .command = "debug.stepInto", .when = "inDebugMode && debugState != 'inactive'" },
    .{ .key = "shift+f11", .command = "debug.stepOut", .when = "inDebugMode && debugState == 'stopped'" },
    .{ .key = "mod+f10", .command = "debug.runToCursor", .when = "inDebugMode && debugState == 'stopped' && editorTextFocus" },
    .{ .key = "mod+f11", .command = "debug.stepIntoTarget", .when = "inDebugMode && debugState == 'stopped'" },
    // workbench.action.tasks.build
    .{ .key = "mod+shift+b", .command = "tasks.runBuild" },
    // renameFile / deleteFile / filesExplorer.copy / cut / paste
    .{ .key = "f2", .command = "explorer.rename", .when = "explorerTreeFocus" },
    .{ .key = "delete", .macos = "cmd+backspace", .command = "explorer.delete", .when = "explorerTreeFocus" },
    .{ .key = "mod+c", .command = "explorer.copy", .when = "explorerTreeFocus" },
    .{ .key = "mod+x", .command = "explorer.cut", .when = "explorerTreeFocus" },
    .{ .key = "mod+v", .command = "explorer.paste", .when = "explorerTreeFocus" },
    // workbench.files.action.refreshFilesExplorer has no default key.
    // workbench.actions.view.problems / editor.action.marker.next / prev
    // (marker.nextInFiles in VS Code)
    .{ .key = "mod+shift+m", .command = "workbench.showProblems" },
    .{ .key = "f8", .command = "editor.nextProblem" },
    .{ .key = "shift+f8", .command = "editor.previousProblem" },
    .{ .key = "mod+c", .command = "problems.copy", .when = "problemsFocus" },
    // Note search (E08.F06.S03.T02 default).
    .{ .key = "mod+shift+n", .command = "notes.search" },
    // Obsidian's "follow link under cursor".
    .{ .key = "alt+enter", .command = "notes.followLink", .when = "editorTextFocus" },
    // editor.action.goToImplementation / goToReferences (F12 is the
    // preset's); workbench.action.navigateBack / navigateForward
    .{ .key = "mod+f12", .command = "editor.goToImplementation", .when = "editorTextFocus" },
    .{ .key = "shift+f12", .command = "editor.findReferences", .when = "editorTextFocus" },
    // editor.showCallHierarchy
    .{ .key = "shift+alt+h", .command = "editor.showCallHierarchy", .when = "editorTextFocus" },
    // editor.action.smartSelect.expand / shrink
    .{ .key = "shift+alt+right", .macos = "ctrl+shift+cmd+right", .command = "editor.expandSelection", .when = "editorTextFocus" },
    .{ .key = "shift+alt+left", .macos = "ctrl+shift+cmd+left", .command = "editor.shrinkSelection", .when = "editorTextFocus" },
    // workbench.action.showAllSymbols (gotoSymbol is the preset's)
    .{ .key = "mod+t", .command = "quickOpen.symbols" },
    // editor.action.formatSelection (formatDocument is the preset's)
    .{ .key = "mod+k mod+f", .command = "editor.formatSelection", .when = "editorTextFocus" },
    .{ .key = "alt+left", .macos = "ctrl+-", .command = "navigation.back" },
    .{ .key = "alt+right", .macos = "ctrl+shift+-", .command = "navigation.forward" },
    // workbench.action.terminal.new / split / focusNext / focusPrevious
    .{ .key = "ctrl+shift+`", .command = "terminal.new" },
    .{ .key = "mod+shift+5", .macos = "mod+\\", .command = "terminal.split", .when = "terminalFocus" },
    .{ .key = "ctrl+pagedown", .macos = "mod+shift+]", .command = "terminal.focusNext", .when = "terminalFocus" },
    .{ .key = "ctrl+pageup", .macos = "mod+shift+[", .command = "terminal.focusPrevious", .when = "terminalFocus" },
    // workbench.action.terminal.scrollToPreviousCommand / ...NextCommand /
    // selectToPreviousCommand / selectToNextCommand
    .{ .key = "mod+up", .command = "terminal.scrollToPrevCommand", .when = "terminalFocus" },
    .{ .key = "mod+down", .command = "terminal.scrollToNextCommand", .when = "terminalFocus" },
    .{ .key = "mod+shift+up", .command = "terminal.selectPrevOutput", .when = "terminalFocus" },
    .{ .key = "mod+shift+down", .command = "terminal.selectNextOutput", .when = "terminalFocus" },
    // workbench.action.terminal.focusFind
    .{ .key = "mod+f", .command = "terminal.find", .when = "terminalFocus" },
    // The completion list, signature help and snippets (VS Code's
    // editor.action.triggerSuggest, selectNextSuggestion, ...,
    // showNextParameterHint, jumpToNextSnippetPlaceholder, leaveSnippet).
    // Later entries win, so the more specific contexts come last.
    .{ .key = "ctrl+space", .command = "editor.triggerSuggest", .when = "editorTextFocus" },
    .{ .key = "ctrl+shift+space", .command = "editor.triggerParameterHints", .when = "editorTextFocus" },
    .{ .key = "tab", .command = "editor.nextSnippetPlaceholder", .when = "editorTextFocus && inSnippetMode && !suggestWidgetVisible" },
    .{ .key = "shift+tab", .command = "editor.previousSnippetPlaceholder", .when = "editorTextFocus && inSnippetMode && !suggestWidgetVisible" },
    .{ .key = "escape", .command = "editor.leaveSnippet", .when = "editorTextFocus && inSnippetMode && !suggestWidgetVisible && !parameterHintsVisible" },
    .{ .key = "escape", .command = "editor.closeParameterHints", .when = "editorTextFocus && parameterHintsVisible && !suggestWidgetVisible" },
    .{ .key = "up", .command = "editor.previousParameterHint", .when = "editorTextFocus && parameterHintsMultipleSignatures && !suggestWidgetVisible" },
    .{ .key = "down", .command = "editor.nextParameterHint", .when = "editorTextFocus && parameterHintsMultipleSignatures && !suggestWidgetVisible" },
    .{ .key = "alt+up", .command = "editor.previousParameterHint", .when = "editorTextFocus && parameterHintsMultipleSignatures && !suggestWidgetVisible" },
    .{ .key = "alt+down", .command = "editor.nextParameterHint", .when = "editorTextFocus && parameterHintsMultipleSignatures && !suggestWidgetVisible" },
    .{ .key = "down", .command = "editor.selectNextSuggestion", .when = "editorTextFocus && suggestWidgetVisible" },
    .{ .key = "up", .command = "editor.selectPreviousSuggestion", .when = "editorTextFocus && suggestWidgetVisible" },
    .{ .key = "pagedown", .command = "editor.selectNextPageSuggestion", .when = "editorTextFocus && suggestWidgetVisible" },
    .{ .key = "pageup", .command = "editor.selectPreviousPageSuggestion", .when = "editorTextFocus && suggestWidgetVisible" },
    .{ .key = "home", .command = "editor.selectFirstSuggestion", .when = "editorTextFocus && suggestWidgetVisible" },
    .{ .key = "end", .command = "editor.selectLastSuggestion", .when = "editorTextFocus && suggestWidgetVisible" },
    .{ .key = "enter", .command = "editor.acceptSuggestion", .when = "editorTextFocus && suggestWidgetVisible" },
    .{ .key = "numpad_enter", .command = "editor.acceptSuggestion", .when = "editorTextFocus && suggestWidgetVisible" },
    .{ .key = "tab", .command = "editor.acceptSuggestion", .when = "editorTextFocus && suggestWidgetVisible" },
    .{ .key = "shift+enter", .command = "editor.acceptAlternativeSuggestion", .when = "editorTextFocus && suggestWidgetVisible" },
    .{ .key = "escape", .command = "editor.hideSuggest", .when = "editorTextFocus && suggestWidgetVisible" },
    .{ .key = "ctrl+space", .command = "editor.toggleSuggestionDetails", .when = "editorTextFocus && suggestWidgetVisible" },
    // The performance HUD (E14.F03.S01.T02 default).
    .{ .key = "ctrl+alt+shift+h", .command = "perf.hud.toggle" },
}
