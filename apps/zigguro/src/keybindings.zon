// zigguro's own key bindings (the preset's lowest layer: presets and the
// user's keybindings.json win). VS Code's explorer keys.
.{
    // workbench.view.explorer
    .{ .key = "mod+shift+e", .command = "workbench.showExplorer" },
    // renameFile / deleteFile / filesExplorer.copy / cut / paste
    .{ .key = "f2", .command = "explorer.rename", .when = "explorerTreeFocus" },
    .{ .key = "delete", .macos = "cmd+backspace", .command = "explorer.delete", .when = "explorerTreeFocus" },
    .{ .key = "mod+c", .command = "explorer.copy", .when = "explorerTreeFocus" },
    .{ .key = "mod+x", .command = "explorer.cut", .when = "explorerTreeFocus" },
    .{ .key = "mod+v", .command = "explorer.paste", .when = "explorerTreeFocus" },
    // workbench.files.action.refreshFilesExplorer has no default key.
}
