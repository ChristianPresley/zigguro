// Package layering table, enforced by `zig build check-layers`.
// A package may depend only on lower layers, or on a same-layer package listed
// in `allow_same_layer` (one tuple per edge, with the spec ID that justified it).
// zg_build is build-time only and exempt. Apps (apps/*) sit at layer 6.
.{
    .layers = .{
        .zg_core = 0,
        .ucdgen = 0, // build-time UCD generator (tools/ucdgen), imported by zg_text (E03.F05.S01.T01)
        .zg_jsonrpc = 1,
        .zg_net = 1,
        .zg_regex = 1,
        .zg_platform = 2,
        .zg_text = 2,
        .zg_vulkan = 2,
        .zg_gui = 3,
        .zg_editor = 4,
        .zg_syntax = 3,
        .zg_terminal = 4,
        .zg_lsp = 4,
        .zg_dap = 4,
        .zg_workspace = 4,
        .zg_notes = 4,
        .zg_scm = 4,
        .zg_git = 4,
        .zg_ai = 4,
        .zg_mcp = 4,
        .zg_review = 4,
        .zg_agents = 4,
        .zg_perf = 4,
        .zg_config = 4,
        .zg_security = 4,
        .zg_mcp_servers = 5,
        .zg_release = 1,
        .zg_update = 2,
        .zg_crash = 2,
        .zg_install = 2,
        // pkgtool:insert
    },
    .allow_same_layer = .{
        .{ "zg_review", "zg_scm" }, // seeded by E00.F03.S01.T03 (E12 review applies changesets through zg_scm)
        .{ "zg_review", "zg_editor" }, // E12.F01.S03.T01 (changesets carry E05 ChangeSets and PendingChanges; zg_review uses zg_editor.model only)
        .{ "zg_review", "zg_ai" }, // E12.F01.S03.T01 (zg_review imports only the zg_ai_proto leaf module, for AgentRef)
        .{ "zg_review", "zg_workspace" }, // E12.F05.S01.T01 (the edit policy uses only the std-only zg_ignore leaf module, for GlobSet)
        .{ "zg_review", "zg_security" }, // E12.F05.S02.T01 (the approvals broker implements zg_security.contracts.ApprovalPort)
        .{ "zg_agents", "zg_ai" }, // seeded by E00.F03.S01.T03 (E13 agents drive the zg_ai loop)
        .{ "zg_dap", "zg_lsp" }, // E07.F06.S01.T01 (DapConnection reuses the zg_lsp transports, server processes and script engine)
        .{ "zg_vulkan", "zg_platform" }, // E02 epic (#3): the renderer targets zg_platform SurfaceTarget/Presenter types (E02.F06.S01.T01)
    },
}
